<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScientificCalculator.ViewModels"
        x:Class="ScientificCalculator.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Calculadora científica"
        Width="450"
        Height="690"
        MinWidth="416"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="#FDCDEA"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        RenderOptions.BitmapInterpolationMode="None">

  <Grid RowDefinitions="36,*">

    <!-- Barra de título propia -->
    <Grid Grid.Row="0"
          Background="#7A3157"
          ColumnDefinitions="Auto,Auto,*"
          PointerPressed="TitleBar_PointerPressed">
      <Image Grid.Column="0"
             Source="/Assets/Original/sailor-icon.png"
             Width="22"
             Height="18"
             Stretch="Uniform"
             Margin="10,0,8,0"
             VerticalAlignment="Center" />

      <TextBlock Grid.Column="1"
                 Text="Calculadora científica"
                 FontSize="12"
                 FontWeight="SemiBold"
                 Foreground="#FFD9E8"
                 VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1" Margin="14,8,14,12"
            BorderBrush="#FDB0DF"
            BorderThickness="3"
            CornerRadius="12"
            ClipToBounds="True"
            BoxShadow="0 10 26 0 #46FDB0DF">
      <Border.Background>
        <ImageBrush Source="/Assets/Original/fondo-export.png" Stretch="Fill" />
      </Border.Background>

      <Grid Margin="9,9,9,4" RowDefinitions="Auto,Auto,Auto,*">

        <!-- Cabecera -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Height="40">
          <Button Classes="icon"
                  Content="☰"
                  Command="{Binding ToggleHistoryCommand}"
                  ToolTip.Tip="Mostrar u ocultar el historial" />

          <TextBlock Grid.Column="2"
                     Text="Calculadora científica"
                     FontSize="15"
                     FontWeight="Bold"
                     Foreground="#4A1E35"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Classes="pill"
                    Classes.active="{Binding IsDegrees}"
                    Content="DEG"
                    Command="{Binding SetDegreesCommand}"
                    ToolTip.Tip="Grados" />
            <Button Classes="pill"
                    Classes.active="{Binding IsRadians}"
                    Content="RAD"
                    Command="{Binding SetRadiansCommand}"
                    ToolTip.Tip="Radianes" />
          </StackPanel>
        </Grid>

        <!-- Pantalla -->
        <Grid Grid.Row="1" Height="110" Margin="0,6,0,6">
          <Image Source="/Assets/Original/pantalla-export.png"
                 Stretch="Fill"
                 IsHitTestVisible="False" />

          <Grid Margin="16,6,16,6" RowDefinitions="Auto,*">
            <TextBlock Text="{Binding SecondaryText}"
                       FontSize="11"
                       Foreground="#401E34"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis"
                       MinHeight="16" />

            <TextBlock Grid.Row="1"
                       Text="{Binding DisplayText}"
                       FontSize="{Binding DisplayFontSize}"
                       FontWeight="SemiBold"
                       Foreground="#401E34"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,2,0,0" />
          </Grid>
        </Grid>

        <!-- Memoria -->
        <UniformGrid Grid.Row="2"
                     Columns="5"
                     Width="310"
                     Height="28"
                     HorizontalAlignment="Center">
          <Button Classes="memo" Content="MC" Command="{Binding MemoryClearCommand}" ToolTip.Tip="Borrar memoria" />
          <Button Classes="memo" Content="MR" Command="{Binding MemoryRecallCommand}" ToolTip.Tip="Recuperar memoria" />
          <Button Classes="memo" Content="M+" Command="{Binding MemoryAddCommand}" ToolTip.Tip="Sumar a la memoria" />
          <Button Classes="memo" Content="M−" Command="{Binding MemorySubtractCommand}" ToolTip.Tip="Restar de la memoria" />
          <Button Classes="memo" Content="MS" Command="{Binding MemoryStoreCommand}" ToolTip.Tip="Guardar en memoria" />
        </UniformGrid>

        <!-- Teclado: 5 columnas x 7 filas -->
        <Viewbox Grid.Row="3"
                 Stretch="Uniform"
                 StretchDirection="DownOnly"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
          <Grid Width="310" Height="445" PointerPressed="Keypad_PointerPressed"
                RowDefinitions="63,63,63,63,63,63,63"
                ColumnDefinitions="62,62,62,62,62">

            <!-- Fila 1 -->
            <Button Grid.Row="0" Grid.Column="0" Classes="pixel" Content="2nd"
                    Command="{Binding ToggleSecondCommand}" AutomationProperties.Name="2nd" ToolTip.Tip="Funciones inversas" />
            <Button Grid.Row="0" Grid.Column="1" Classes="pixel" Content="π"
                    Command="{Binding InputConstantCommand}" CommandParameter="π" AutomationProperties.Name="pi" ToolTip.Tip="Pi" />
            <Button Grid.Row="0" Grid.Column="2" Classes="pixel" Content="e"
                    Command="{Binding InputConstantCommand}" CommandParameter="e" AutomationProperties.Name="euler" ToolTip.Tip="Número de Euler" />
            <Button Grid.Row="0" Grid.Column="3" Classes="key" AutomationProperties.Name="CE"
                    Command="{Binding ClearEntryCommand}" ToolTip.Tip="Borrar la entrada">
              <Grid>
                <Image Source="/Assets/Original/normal_c_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_c_btn.png" />
              </Grid>
            </Button>
            <Button Grid.Row="0" Grid.Column="4" Classes="pixel" Content="←"
                    Command="{Binding BackspaceCommand}" AutomationProperties.Name="borrar" ToolTip.Tip="Borrar un carácter" />

            <!-- Fila 2 -->
            <Button Grid.Row="1" Grid.Column="0" Classes="pixel" Content="x²"
                    Command="{Binding InputOperatorCommand}" CommandParameter="^2" AutomationProperties.Name="cuadrado" ToolTip.Tip="Cuadrado" />
            <Button Grid.Row="1" Grid.Column="1" Classes="pixel" Content="1/x"
                    Command="{Binding InputReciprocalCommand}" AutomationProperties.Name="reciproco" ToolTip.Tip="Recíproco" />
            <Button Grid.Row="1" Grid.Column="2" Classes="pixel" Content="|x|"
                    Command="{Binding InputAbsCommand}" AutomationProperties.Name="valor_absoluto" ToolTip.Tip="Valor absoluto" />
            <Button Grid.Row="1" Grid.Column="3" Classes="pixel" Content="exp"
                    Command="{Binding InputExpCommand}" AutomationProperties.Name="EXP" ToolTip.Tip="Notación científica" />
            <Button Grid.Row="1" Grid.Column="4" Classes="pixel" Content="%"
                    Command="{Binding InputPercentCommand}" AutomationProperties.Name="mod" ToolTip.Tip="Porcentaje / modulo" />

            <!-- Fila 3 -->
            <Button Grid.Row="2" Grid.Column="0" Classes="pixel" Content="√"
                    Command="{Binding ScienceCommand}" CommandParameter="sqrt" AutomationProperties.Name="raiz"
                    ToolTip.Tip="Raíz cuadrada · raíz cúbica con 2nd" />
            <Button Grid.Row="2" Grid.Column="1" Classes="pixel" Content="("
                    Command="{Binding InputOpenParenCommand}" AutomationProperties.Name="parentesis_abre" ToolTip.Tip="Abrir paréntesis" />
            <Button Grid.Row="2" Grid.Column="2" Classes="pixel" Content=")"
                    Command="{Binding InputCloseParenCommand}" AutomationProperties.Name="parentesis_cierra" ToolTip.Tip="Cerrar paréntesis" />
            <Button Grid.Row="2" Grid.Column="3" Classes="pixel" Content="n!"
                    Command="{Binding InputFactorialCommand}" AutomationProperties.Name="factorial" ToolTip.Tip="Factorial" />
            <Button Grid.Row="2" Grid.Column="4" Classes="key" AutomationProperties.Name="division"
                    Command="{Binding InputOperatorCommand}" CommandParameter="/">
              <Grid>
                <Image Source="/Assets/Original/normal_divide_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_divide_btn.png" />
              </Grid>
            </Button>

            <!-- Fila 4 -->
            <Button Grid.Row="3" Grid.Column="0" Classes="pixel" Content="xʸ"
                    Command="{Binding InputPowerCommand}" AutomationProperties.Name="potencia" ToolTip.Tip="Potencia" />
            <Button Grid.Row="3" Grid.Column="1" Classes="key" AutomationProperties.Name="7">
              <Grid>
                <Image Source="/Assets/Original/normal_7_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_7_btn.png" />
              </Grid>
            </Button>
            <Button Grid.Row="3" Grid.Column="2" Classes="key" AutomationProperties.Name="8">
              <Grid>
                <Image Source="/Assets/Original/normal_8_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_8_btn.png" />
              </Grid>
            </Button>
            <Button Grid.Row="3" Grid.Column="3" Classes="key" AutomationProperties.Name="9">
              <Grid>
                <Image Source="/Assets/Original/normal_9_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_9_btn.png" />
              </Grid>
            </Button>
            <Button Grid.Row="3" Grid.Column="4" Classes="key" AutomationProperties.Name="multiplicar">
              <Grid>
                <Image Source="/Assets/Original/normal_x_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_x_btn.png" />
              </Grid>
            </Button>

            <!-- Fila 5 -->
            <Button Grid.Row="4" Grid.Column="0" Classes="pixel" Content="10ˣ"
                    Command="{Binding InputFunctionCommand}" CommandParameter="10^" AutomationProperties.Name="10x" ToolTip.Tip="10 elevado al exponente" />
            <Button Grid.Row="4" Grid.Column="1" Classes="key" AutomationProperties.Name="4">
              <Grid>
                <Image Source="/Assets/Original/normal_4_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_4_btn.png" />
              </Grid>
            </Button>
            <Button Grid.Row="4" Grid.Column="2" Classes="key" AutomationProperties.Name="5">
              <Grid>
                <Image Source="/Assets/Original/normal_5_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_5_btn.png" />
              </Grid>
            </Button>
            <Button Grid.Row="4" Grid.Column="3" Classes="key" AutomationProperties.Name="6">
              <Grid>
                <Image Source="/Assets/Original/normal_6_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_6_btn.png" />
              </Grid>
            </Button>
            <Button Grid.Row="4" Grid.Column="4" Classes="key" AutomationProperties.Name="menos">
              <Grid>
                <Image Source="/Assets/Original/normal_-_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_-_btn.png" />
              </Grid>
            </Button>

            <!-- Fila 6 -->
            <Button Grid.Row="5" Grid.Column="0" Classes="pixel" Content="log"
                    Command="{Binding ScienceCommand}" CommandParameter="log" AutomationProperties.Name="log"
                    ToolTip.Tip="log: base 10 · 10ˣ con 2nd" />
            <Button Grid.Row="5" Grid.Column="1" Classes="key" AutomationProperties.Name="1">
              <Grid>
                <Image Source="/Assets/Original/normal_1_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_1_btn.png" />
              </Grid>
            </Button>
            <Button Grid.Row="5" Grid.Column="2" Classes="key" AutomationProperties.Name="2">
              <Grid>
                <Image Source="/Assets/Original/normal_2_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_2_btn.png" />
              </Grid>
            </Button>
            <Button Grid.Row="5" Grid.Column="3" Classes="key" AutomationProperties.Name="3">
              <Grid>
                <Image Source="/Assets/Original/normal_3_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_3_btn.png" />
              </Grid>
            </Button>
            <Button Grid.Row="5" Grid.Column="4" Classes="key" AutomationProperties.Name="mas">
              <Grid>
                <Image Source="/Assets/Original/normal_+_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_+_btn.png" />
              </Grid>
            </Button>

            <!-- Fila 7 -->
            <Button Grid.Row="6" Grid.Column="0" Classes="pixel" Content="ln"
                    Command="{Binding ScienceCommand}" CommandParameter="ln" AutomationProperties.Name="ln"
                    ToolTip.Tip="ln: logaritmo natural · eˣ con 2nd" />
            <Button Grid.Row="6" Grid.Column="1" Classes="pixel" Content="±"
                    Command="{Binding ToggleSignCommand}" AutomationProperties.Name="cambiar_signo" ToolTip.Tip="Cambiar de signo" />
            <Button Grid.Row="6" Grid.Column="2" Classes="key" AutomationProperties.Name="0">
              <Grid>
                <Image Source="/Assets/Original/normal_0_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_0_btn.png" />
              </Grid>
            </Button>
            <Button Grid.Row="6" Grid.Column="3" Classes="key" AutomationProperties.Name="coma">
              <Grid>
                <Image Source="/Assets/Original/normal_,_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_,_btn.png" />
              </Grid>
            </Button>
            <Button Grid.Row="6" Grid.Column="4" Classes="key" AutomationProperties.Name="igual">
              <Grid>
                <Image Source="/Assets/Original/normal_=_btn.png" />
                <Image Source="/Assets/Original/Pressed/pressed_=_btn.png" />
              </Grid>
            </Button>
          </Grid>
        </Viewbox>

        <!-- Historial -->
        <Border Grid.Row="1" Grid.RowSpan="3"
                Width="320"
                HorizontalAlignment="Left"
                Padding="10"
                Background="#2A1520"
                BorderBrush="#FFB6D5"
                BorderThickness="2"
                CornerRadius="4"
                BoxShadow="0 8 24 0 #55000000"
                IsVisible="{Binding IsHistoryOpen}">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="4,2,2,6">
              <TextBlock Text="Historial" FontSize="15" FontWeight="Bold" Foreground="#FFE3F0" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="link" Content="Borrar" Command="{Binding ClearHistoryCommand}" />
              <Button Grid.Column="2" Classes="link" Content="✕" Command="{Binding ToggleHistoryCommand}" ToolTip.Tip="Cerrar historial" />
            </Grid>

            <ScrollViewer Grid.Row="1">
              <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryEntry">
                    <Button Classes="history"
                            Tag="{Binding Value}"
                            Click="History_Click"
                            ToolTip.Tip="Usar este resultado">
                      <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Expression}"
                                   FontSize="12"
                                   Foreground="#E8A6C5"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Result}"
                                   FontSize="19"
                                   Foreground="#FFF4F8"
                                   HorizontalAlignment="Right" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

      </Grid>
    </Border>
  </Grid>
</Window>
