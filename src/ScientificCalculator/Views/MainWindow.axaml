<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScientificCalculator.ViewModels"
        x:Class="ScientificCalculator.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Calculadora científica"
        Width="447"
        Height="680"
        MinWidth="416"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="#7A3157"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        RenderOptions.BitmapInterpolationMode="None">

  <Grid RowDefinitions="36,*">

    <!-- Barra de título propia (evita la franja blanca del sistema) -->
    <Grid Grid.Row="0"
          Background="#7A3157"
          ColumnDefinitions="Auto,Auto,*"
          PointerPressed="TitleBar_PointerPressed">
      <Image Grid.Column="0"
             Source="/Assets/Original/sailor-icon.png"
             Width="22"
             Height="18"
             Stretch="Uniform"
             Margin="10,0,8,0"
             VerticalAlignment="Center" />

      <TextBlock Grid.Column="1"
                 Text="Calculadora científica"
                 FontSize="12"
                 FontWeight="SemiBold"
                 Foreground="#FFD9E8"
                 VerticalAlignment="Center" />
    </Grid>

    <!-- Cuerpo de la calculadora con la paleta pixel art original -->
    <Border Grid.Row="1" Margin="14,8,14,14"
            Background="#FFAACB"
            BorderBrush="#D980A2"
            BorderThickness="3"
            CornerRadius="10"
            ClipToBounds="True"
            BoxShadow="0 12 28 0 #40000000">

      <Grid Margin="12,12,12,8" RowDefinitions="Auto,Auto,Auto,*">

        <!-- Cabecera -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Height="40">
          <Button Classes="icon"
                  Content="☰"
                  Command="{Binding ToggleHistoryCommand}"
                  ToolTip.Tip="Mostrar u ocultar el historial" />

          <TextBlock Grid.Column="2"
                     Text="Calculadora científica"
                     FontSize="15"
                     FontWeight="Bold"
                     Foreground="#4A1E35"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Classes="pill"
                    Classes.active="{Binding IsDegrees}"
                    Content="DEG"
                    Command="{Binding SetDegreesCommand}"
                    ToolTip.Tip="Grados" />
            <Button Classes="pill"
                    Classes.active="{Binding IsRadians}"
                    Content="RAD"
                    Command="{Binding SetRadiansCommand}"
                    ToolTip.Tip="Radianes" />
          </StackPanel>
        </Grid>

        <!-- Pantalla -->
        <Grid Grid.Row="1" Height="120" Margin="0,6,0,6">
          <Border Background="#2A1520"
                  BorderBrush="#FFE7ED"
                  BorderThickness="4"
                  CornerRadius="2"
                  BoxShadow="0 0 0 3 #D980A2" />

          <Grid Margin="16,8,16,8" RowDefinitions="Auto,*">
            <TextBlock Text="{Binding SecondaryText}"
                       FontSize="11"
                       Foreground="#E8A6C5"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis"
                       MinHeight="16" />

            <TextBlock Grid.Row="1"
                       Text="{Binding DisplayText}"
                       FontSize="{Binding DisplayFontSize}"
                       FontWeight="SemiBold"
                       Foreground="#FFF4F8"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,3,0,0" />
          </Grid>
        </Grid>

        <!-- Memoria -->
        <UniformGrid Grid.Row="2"
                     Columns="5"
                     Width="396"
                     Height="28"
                     HorizontalAlignment="Center">
          <Button Classes="memo" Content="MC" Command="{Binding MemoryClearCommand}" ToolTip.Tip="Borrar memoria" />
          <Button Classes="memo" Content="MR" Command="{Binding MemoryRecallCommand}" ToolTip.Tip="Recuperar memoria" />
          <Button Classes="memo" Content="M+" Command="{Binding MemoryAddCommand}" ToolTip.Tip="Sumar a la memoria" />
          <Button Classes="memo" Content="M−" Command="{Binding MemorySubtractCommand}" ToolTip.Tip="Restar de la memoria" />
          <Button Classes="memo" Content="MS" Command="{Binding MemoryStoreCommand}" ToolTip.Tip="Guardar en memoria" />
        </UniformGrid>

        <!-- Teclado: cuadrícula 8x5 escalada en un Viewbox -->
        <Viewbox Grid.Row="3"
                 Stretch="Uniform"
                 StretchDirection="DownOnly"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
          <Grid Width="432" Height="240"
                RowDefinitions="48,48,48,48,48"
                ColumnDefinitions="54,54,54,54,54,54,54,54">

            <!-- Panel científico (cols 0-3) -->
            <Button Grid.Row="0" Grid.Column="0"
                    Classes="pixel"
                    Classes.active="{Binding IsSecondActive}"
                    Content="2nd"
                    Command="{Binding ToggleSecondCommand}"
                    AutomationProperties.Name="2nd"
                    ToolTip.Tip="Funciones inversas" />
            <Button Grid.Row="0" Grid.Column="1" Classes="pixel" Content="{Binding SinLabel}" Command="{Binding ScienceCommand}" CommandParameter="sin" AutomationProperties.Name="sin" />
            <Button Grid.Row="0" Grid.Column="2" Classes="pixel" Content="{Binding CosLabel}" Command="{Binding ScienceCommand}" CommandParameter="cos" AutomationProperties.Name="cos" />
            <Button Grid.Row="0" Grid.Column="3" Classes="pixel" Content="{Binding TanLabel}" Command="{Binding ScienceCommand}" CommandParameter="tan" AutomationProperties.Name="tan" />

            <Button Grid.Row="1" Grid.Column="0" Classes="pixel" Content="(" Command="{Binding InputOpenParenCommand}" AutomationProperties.Name="parentesis_abre" />
            <Button Grid.Row="1" Grid.Column="1" Classes="pixel" Content=")" Command="{Binding InputCloseParenCommand}" AutomationProperties.Name="parentesis_cierra" />
            <Button Grid.Row="1" Grid.Column="2" Classes="pixel" Content="π" Command="{Binding InputConstantCommand}" CommandParameter="π" AutomationProperties.Name="pi" ToolTip.Tip="Pi" />
            <Button Grid.Row="1" Grid.Column="3" Classes="pixel" Content="e" Command="{Binding InputConstantCommand}" CommandParameter="e" AutomationProperties.Name="euler" ToolTip.Tip="Número de Euler" />

            <Button Grid.Row="2" Grid.Column="0" Classes="pixel" Content="{Binding LogLabel}" Command="{Binding ScienceCommand}" CommandParameter="log" AutomationProperties.Name="log" ToolTip.Tip="log: base 10 · 10ˣ con 2nd" />
            <Button Grid.Row="2" Grid.Column="1" Classes="pixel" Content="{Binding LnLabel}" Command="{Binding ScienceCommand}" CommandParameter="ln" AutomationProperties.Name="ln" ToolTip.Tip="ln: logaritmo natural · eˣ con 2nd" />
            <Button Grid.Row="2" Grid.Column="2" Classes="pixel" Content="{Binding SqrtLabel}" Command="{Binding ScienceCommand}" CommandParameter="sqrt" AutomationProperties.Name="sqrt" ToolTip.Tip="Raíz cuadrada · raíz cúbica con 2nd" />
            <Button Grid.Row="2" Grid.Column="3" Classes="pixel" Content="{Binding SquareLabel}" Command="{Binding ScienceCommand}" CommandParameter="square" AutomationProperties.Name="square" />

            <Button Grid.Row="3" Grid.Column="0" Classes="pixel" Content="xʸ" Command="{Binding InputPowerCommand}" AutomationProperties.Name="potencia" ToolTip.Tip="Potencia" />
            <Button Grid.Row="3" Grid.Column="1" Classes="pixel" Content="n!" Command="{Binding InputFactorialCommand}" AutomationProperties.Name="factorial" ToolTip.Tip="Factorial" />
            <Button Grid.Row="3" Grid.Column="2" Classes="pixel" Content="1/x" Command="{Binding InputReciprocalCommand}" AutomationProperties.Name="reciproco" />
            <Button Grid.Row="3" Grid.Column="3" Classes="pixel" Content="%" Command="{Binding InputPercentCommand}" AutomationProperties.Name="porcentaje" />

            <Button Grid.Row="4" Grid.Column="0" Classes="pixel" Content="|x|" Command="{Binding InputAbsCommand}" AutomationProperties.Name="valor_absoluto" />
            <Button Grid.Row="4" Grid.Column="1" Classes="pixel" Content="EXP" Command="{Binding InputExpCommand}" AutomationProperties.Name="EXP" ToolTip.Tip="Notación científica" />
            <Button Grid.Row="4" Grid.Column="2" Classes="pixel" Content="ANS" Command="{Binding InputAnsCommand}" AutomationProperties.Name="ANS" ToolTip.Tip="Último resultado" />
            <Button Grid.Row="4" Grid.Column="3" Classes="pixel" Content="HIST" Command="{Binding ToggleHistoryCommand}" AutomationProperties.Name="HIST" ToolTip.Tip="Mostrar u ocultar el historial" />

            <!-- Panel estándar: PNGs originales con variante pressed exportada -->
            <Button Grid.Row="0" Grid.Column="4" Classes="key" Command="{Binding ClearAllCommand}" ToolTip.Tip="Borrar todo" AutomationProperties.Name="C">
              <Grid>
                <Image Source="/Assets/Original/normal_c_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_c_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
            <Button Grid.Row="0" Grid.Column="5" Classes="key" Command="{Binding InputOperatorCommand}" CommandParameter="/" ToolTip.Tip="Dividir" AutomationProperties.Name="÷">
              <Grid>
                <Image Source="/Assets/Original/normal_divide_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_divide_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
            <Button Grid.Row="0" Grid.Column="6" Classes="key" Command="{Binding InputDigitCommand}" CommandParameter="7" ToolTip.Tip="7" AutomationProperties.Name="7">
              <Grid>
                <Image Source="/Assets/Original/normal_7_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_7_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
            <Button Grid.Row="0" Grid.Column="7" Classes="key" Command="{Binding InputOperatorCommand}" CommandParameter="*" ToolTip.Tip="Multiplicar" AutomationProperties.Name="×">
              <Grid>
                <Image Source="/Assets/Original/normal_x_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_x_btn.png" Classes="img pressed" />
              </Grid>
            </Button>

            <Button Grid.Row="1" Grid.Column="4" Classes="key" Command="{Binding InputDigitCommand}" CommandParameter="8" ToolTip.Tip="8" AutomationProperties.Name="8">
              <Grid>
                <Image Source="/Assets/Original/normal_8_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_8_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
            <Button Grid.Row="1" Grid.Column="5" Classes="key" Command="{Binding InputDecimalCommand}" ToolTip.Tip="Separador decimal" AutomationProperties.Name="coma">
              <Grid>
                <Image Source="/Assets/Original/normal_,_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_,_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
            <Button Grid.Row="1" Grid.Column="6" Classes="key" Command="{Binding InputDigitCommand}" CommandParameter="9" ToolTip.Tip="9" AutomationProperties.Name="9">
              <Grid>
                <Image Source="/Assets/Original/normal_9_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_9_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
            <Button Grid.Row="1" Grid.Column="7" Classes="pixel" Content="←" Command="{Binding BackspaceCommand}" AutomationProperties.Name="borrar" ToolTip.Tip="Borrar un carácter" />

            <Button Grid.Row="2" Grid.Column="4" Classes="key" Command="{Binding InputDigitCommand}" CommandParameter="4" ToolTip.Tip="4" AutomationProperties.Name="4">
              <Grid>
                <Image Source="/Assets/Original/normal_4_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_4_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
            <Button Grid.Row="2" Grid.Column="5" Classes="key" Command="{Binding InputDigitCommand}" CommandParameter="5" ToolTip.Tip="5" AutomationProperties.Name="5">
              <Grid>
                <Image Source="/Assets/Original/normal_5_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_5_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
            <Button Grid.Row="2" Grid.Column="6" Classes="key" Command="{Binding InputDigitCommand}" CommandParameter="6" ToolTip.Tip="6" AutomationProperties.Name="6">
              <Grid>
                <Image Source="/Assets/Original/normal_6_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_6_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
            <Button Grid.Row="2" Grid.Column="7" Classes="pixel" Content="−" Command="{Binding InputOperatorCommand}" CommandParameter="-" AutomationProperties.Name="menos" ToolTip.Tip="Restar" />

            <Button Grid.Row="3" Grid.Column="4" Classes="key" Command="{Binding InputDigitCommand}" CommandParameter="1" ToolTip.Tip="1" AutomationProperties.Name="1">
              <Grid>
                <Image Source="/Assets/Original/normal_1_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_1_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
            <Button Grid.Row="3" Grid.Column="5" Classes="key" Command="{Binding InputDigitCommand}" CommandParameter="2" ToolTip.Tip="2" AutomationProperties.Name="2">
              <Grid>
                <Image Source="/Assets/Original/normal_2_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_2_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
            <Button Grid.Row="3" Grid.Column="6" Classes="key" Command="{Binding InputDigitCommand}" CommandParameter="3" ToolTip.Tip="3" AutomationProperties.Name="3">
              <Grid>
                <Image Source="/Assets/Original/normal_3_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_3_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
            <Button Grid.Row="3" Grid.Column="7" Classes="pixel" Content="+" Command="{Binding InputOperatorCommand}" CommandParameter="+" AutomationProperties.Name="mas" ToolTip.Tip="Sumar" />

            <Button Grid.Row="4" Grid.Column="4" Classes="key" Command="{Binding InputDigitCommand}" CommandParameter="0" ToolTip.Tip="0" AutomationProperties.Name="0">
              <Grid>
                <Image Source="/Assets/Original/normal_0_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_0_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
            <Button Grid.Row="4" Grid.Column="5" Classes="key" Command="{Binding InputOperatorCommand}" CommandParameter="*" ToolTip.Tip="Multiplicar" AutomationProperties.Name="multiplicar">
              <Grid>
                <Image Source="/Assets/Original/normal_x_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_x_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
            <Button Grid.Row="4" Grid.Column="6" Classes="pixel" Content="CE" Command="{Binding ClearEntryCommand}" AutomationProperties.Name="CE" ToolTip.Tip="Borrar la entrada" />
            <Button Grid.Row="4" Grid.Column="7" Classes="key" Command="{Binding CalculateEqualsCommand}" ToolTip.Tip="Calcular" AutomationProperties.Name="=">
              <Grid>
                <Image Source="/Assets/Original/normal_=_btn.png" Classes="img pressed" />
                <Image Source="/Assets/Original/Pressed/pressed_=_btn.png" Classes="img pressed" />
              </Grid>
            </Button>
          </Grid>
        </Viewbox>

        <!-- Historial -->
        <Border Grid.Row="1" Grid.RowSpan="3"
                Width="320"
                HorizontalAlignment="Left"
                Padding="10"
                Background="#2A1520"
                BorderBrush="#FFB6D5"
                BorderThickness="2"
                CornerRadius="4"
                BoxShadow="0 8 24 0 #55000000"
                IsVisible="{Binding IsHistoryOpen}">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="4,2,2,6">
              <TextBlock Text="Historial" FontSize="15" FontWeight="Bold" Foreground="#FFE3F0" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="link" Content="Borrar" Command="{Binding ClearHistoryCommand}" />
              <Button Grid.Column="2" Classes="link" Content="✕" Command="{Binding ToggleHistoryCommand}" ToolTip.Tip="Cerrar historial" />
            </Grid>

            <ScrollViewer Grid.Row="1">
              <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryEntry">
                    <Button Classes="history"
                            Tag="{Binding Value}"
                            Click="History_Click"
                            ToolTip.Tip="Usar este resultado">
                      <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Expression}"
                                   FontSize="12"
                                   Foreground="#E8A6C5"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Result}"
                                   FontSize="19"
                                   Foreground="#FFF4F8"
                                   HorizontalAlignment="Right" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

      </Grid>
    </Border>
  </Grid>
</Window>
