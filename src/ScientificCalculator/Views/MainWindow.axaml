<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScientificCalculator.ViewModels"
        x:Class="ScientificCalculator.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Calculadora científica"
        Width="450"
        Height="690"
        MinWidth="450"
        MaxWidth="450"
        MinHeight="690"
        MaxHeight="690"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        RenderOptions.BitmapInterpolationMode="None">

  <!-- Marco exterior kawaii con esquinas redondeadas y borde pastel -->
  <Border Background="#FFB8DC"
          BorderBrush="#7B2856"
          BorderThickness="2"
          CornerRadius="16"
          ClipToBounds="True"
          BoxShadow="0 10 30 0 #557A2855">

    <Grid RowDefinitions="36,*">

      <!-- Barra de título kawaii propia -->
      <Grid Grid.Row="0"
            Background="#FFB8DC"
            ColumnDefinitions="Auto,Auto,*,Auto"
            PointerPressed="TitleBar_PointerPressed"
            Height="36">
        <Image Grid.Column="0"
               Source="/Assets/Original/icon_calculator.png"
               Width="22"
               Height="18"
               Stretch="Uniform"
               Margin="12,0,8,0"
               VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Calculadora científica"
                     FontSize="13"
                     FontWeight="Bold"
                     Foreground="#52183B"
                     VerticalAlignment="Center" />
          <TextBlock Text=" ✧"
                     FontSize="12"
                     Foreground="#FF6EA8"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Cápsula con botones de ventana (minimizar y cerrar) -->
        <Border Grid.Column="3"
                Background="#FFD3E8"
                BorderBrush="#FFA8D2"
                BorderThickness="1.5"
                CornerRadius="12"
                Margin="0,0,10,0"
                Padding="3,1"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="caption" Content="−" Click="Minimize_Click" ToolTip.Tip="Minimizar" />
            <Button Classes="caption" Content="✕" Click="Close_Click" ToolTip.Tip="Cerrar" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Cuerpo principal de la calculadora con fondo original -->
      <Border Grid.Row="1" Margin="12,4,12,12"
              BorderBrush="#FFA8D2"
              BorderThickness="3"
              CornerRadius="14"
              ClipToBounds="True"
              BoxShadow="0 8 20 0 #338B2658">
        <Border.Background>
          <ImageBrush Source="/Assets/Original/fondo-export.png" Stretch="Fill" />
        </Border.Background>

        <Grid Margin="10,8,10,6" RowDefinitions="Auto,Auto,Auto,*">

          <!-- Cabecera -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="36">
            <Button Classes="icon"
                    Content="☰"
                    Command="{Binding ToggleHistoryCommand}"
                    ToolTip.Tip="Mostrar u ocultar el historial" />

            <!-- Píldora DEG / RAD -->
            <Border Grid.Column="2"
                    Background="#FFF2F8"
                    BorderBrush="#FFAED5"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="2"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="pill"
                        Classes.active="{Binding IsDegrees}"
                        Content="DEG"
                        Command="{Binding SetDegreesCommand}"
                        ToolTip.Tip="Grados" />
                <Button Classes="pill"
                        Classes.active="{Binding IsRadians}"
                        Content="RAD"
                        Command="{Binding SetRadiansCommand}"
                        ToolTip.Tip="Radianes" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Pantalla con diseño original -->
          <Grid Grid.Row="1" Height="110" Margin="0,4,0,6">
            <Image Source="/Assets/Original/pantalla-export.png"
                   Stretch="Fill"
                   IsHitTestVisible="False" />

            <!-- Detalle kawaii: corazoncito en esquina superior izquierda -->
            <TextBlock Text="♥"
                       FontSize="11"
                       Foreground="#FFA8D2"
                       Opacity="0.8"
                       Margin="16,8,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False" />

            <Grid Margin="18,8,18,8" RowDefinitions="Auto,*">
              <TextBlock Text="{Binding SecondaryText}"
                         FontSize="12"
                         Foreground="#FFBEE0"
                         HorizontalAlignment="Right"
                         TextTrimming="CharacterEllipsis"
                         MinHeight="18" />

              <TextBlock Grid.Row="1"
                         Text="{Binding DisplayText}"
                         FontSize="{Binding DisplayFontSize}"
                         FontWeight="Bold"
                         Foreground="#FFFFFF"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         TextTrimming="CharacterEllipsis"
                         Margin="0,0,0,4" />
            </Grid>
          </Grid>

          <!-- Fila de memoria -->
          <UniformGrid Grid.Row="2"
                       Columns="5"
                       Width="310"
                       Height="28"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4">
            <Button Classes="memo" Content="MC" Command="{Binding MemoryClearCommand}" ToolTip.Tip="Borrar memoria" AutomationProperties.Name="MC" />
            <Button Classes="memo" Content="MR" Command="{Binding MemoryRecallCommand}" ToolTip.Tip="Recuperar memoria" AutomationProperties.Name="MR" />
            <Button Classes="memo" Content="M+" Command="{Binding MemoryAddCommand}" ToolTip.Tip="Sumar a la memoria" AutomationProperties.Name="M+" />
            <Button Classes="memo" Content="M−" Command="{Binding MemorySubtractCommand}" ToolTip.Tip="Restar de la memoria" AutomationProperties.Name="M-" />
            <Button Classes="memo" Content="MS" Command="{Binding MemoryStoreCommand}" ToolTip.Tip="Guardar en memoria" AutomationProperties.Name="MS" />
          </UniformGrid>

          <!-- Teclado: 5 columnas x 7 filas en Viewbox -->
          <Viewbox Grid.Row="3"
                   Stretch="Uniform"
                   StretchDirection="DownOnly"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <Grid Width="310" Height="445"
                  RowDefinitions="63,63,63,63,63,63,63"
                  ColumnDefinitions="62,62,62,62,62">

              <!-- Fila 1 -->
              <Button Grid.Row="0" Grid.Column="0" Classes="key" AutomationProperties.Name="2nd"
                      Command="{Binding ToggleSecondCommand}" ToolTip.Tip="Funciones inversas">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_2nd_btn-export.png" />
                  <Image Classes="pressed" Source="/Assets/Original/pressed_2nd_btn-export.png" />
                </Grid>
              </Button>
              <Button Grid.Row="0" Grid.Column="1" Classes="pixel" Content="π"
                      Command="{Binding InputConstantCommand}" CommandParameter="π" AutomationProperties.Name="pi" ToolTip.Tip="Pi" />
              <Button Grid.Row="0" Grid.Column="2" Classes="pixel" Content="e"
                      Command="{Binding InputConstantCommand}" CommandParameter="e" AutomationProperties.Name="euler" ToolTip.Tip="Número de Euler" />
              <Button Grid.Row="0" Grid.Column="3" Classes="key" AutomationProperties.Name="CE"
                      Command="{Binding ClearEntryCommand}" ToolTip.Tip="Borrar la entrada">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_c_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_c_btn.png" />
                </Grid>
              </Button>
              <Button Grid.Row="0" Grid.Column="4" Classes="pixel" Content="←"
                      Command="{Binding BackspaceCommand}" AutomationProperties.Name="borrar" ToolTip.Tip="Borrar un carácter" />

              <!-- Fila 2 -->
              <Button Grid.Row="1" Grid.Column="0" Classes="pixel" Content="{Binding SquareLabel}"
                      Command="{Binding InputOperatorCommand}" CommandParameter="^2" AutomationProperties.Name="cuadrado" ToolTip.Tip="Cuadrado · cubo con 2nd" />
              <Button Grid.Row="1" Grid.Column="1" Classes="pixel" Content="1/x"
                      Command="{Binding InputReciprocalCommand}" AutomationProperties.Name="reciproco" ToolTip.Tip="Recíproco" />
              <Button Grid.Row="1" Grid.Column="2" Classes="pixel" Content="|x|"
                      Command="{Binding InputAbsCommand}" AutomationProperties.Name="valor_absoluto" ToolTip.Tip="Valor absoluto" />
              <Button Grid.Row="1" Grid.Column="3" Classes="key" AutomationProperties.Name="EXP" ToolTip.Tip="Notación científica">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_exp_btn-export.png" />
                  <Image Classes="pressed" Source="/Assets/Original/pressed_exp_btn-export.png" />
                </Grid>
              </Button>
              <Button Grid.Row="1" Grid.Column="4" Classes="key" AutomationProperties.Name="mod" ToolTip.Tip="Porcentaje / módulo">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_%_btn-export.png" />
                  <Image Classes="pressed" Source="/Assets/Original/pressed_%_btn-export.png" />
                </Grid>
              </Button>

              <!-- Fila 3 -->
              <Button Grid.Row="2" Grid.Column="0" Classes="pixel" Content="{Binding SqrtLabel}"
                      Command="{Binding ScienceCommand}" CommandParameter="sqrt" AutomationProperties.Name="raiz"
                      ToolTip.Tip="Raíz cuadrada · raíz cúbica con 2nd" />
              <Button Grid.Row="2" Grid.Column="1" Classes="pixel" Content="("
                      Command="{Binding InputOpenParenCommand}" AutomationProperties.Name="parentesis_abre" ToolTip.Tip="Abrir paréntesis" />
              <Button Grid.Row="2" Grid.Column="2" Classes="pixel" Content=")"
                      Command="{Binding InputCloseParenCommand}" AutomationProperties.Name="parentesis_cierra" ToolTip.Tip="Cerrar paréntesis" />
              <Button Grid.Row="2" Grid.Column="3" Classes="pixel" Content="n!"
                      Command="{Binding InputFactorialCommand}" AutomationProperties.Name="factorial" ToolTip.Tip="Factorial" />
              <Button Grid.Row="2" Grid.Column="4" Classes="key" AutomationProperties.Name="division"
                      Command="{Binding InputOperatorCommand}" CommandParameter="/" ToolTip.Tip="Dividir">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_divide_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_divide_btn.png" />
                </Grid>
              </Button>

              <!-- Fila 4 -->
              <Button Grid.Row="3" Grid.Column="0" Classes="pixel" Content="xʸ"
                      Command="{Binding InputPowerCommand}" AutomationProperties.Name="potencia" ToolTip.Tip="Potencia" />
              <Button Grid.Row="3" Grid.Column="1" Classes="key" AutomationProperties.Name="7"
                      Command="{Binding InputDigitCommand}" CommandParameter="7" ToolTip.Tip="7">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_7_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_7_btn.png" />
                </Grid>
              </Button>
              <Button Grid.Row="3" Grid.Column="2" Classes="key" AutomationProperties.Name="8"
                      Command="{Binding InputDigitCommand}" CommandParameter="8" ToolTip.Tip="8">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_8_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_8_btn.png" />
                </Grid>
              </Button>
              <Button Grid.Row="3" Grid.Column="3" Classes="key" AutomationProperties.Name="9"
                      Command="{Binding InputDigitCommand}" CommandParameter="9" ToolTip.Tip="9">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_9_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_9_btn.png" />
                </Grid>
              </Button>
              <Button Grid.Row="3" Grid.Column="4" Classes="key" AutomationProperties.Name="multiplicar"
                      Command="{Binding InputOperatorCommand}" CommandParameter="*" ToolTip.Tip="Multiplicar">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_x_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_x_btn.png" />
                </Grid>
              </Button>

              <!-- Fila 5 -->
              <Button Grid.Row="4" Grid.Column="0" Classes="pixel" Content="10ˣ"
                      Command="{Binding InputFunctionCommand}" CommandParameter="10^" AutomationProperties.Name="10x" ToolTip.Tip="10 elevado al exponente" />
              <Button Grid.Row="4" Grid.Column="1" Classes="key" AutomationProperties.Name="4"
                      Command="{Binding InputDigitCommand}" CommandParameter="4" ToolTip.Tip="4">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_4_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_4_btn.png" />
                </Grid>
              </Button>
              <Button Grid.Row="4" Grid.Column="2" Classes="key" AutomationProperties.Name="5"
                      Command="{Binding InputDigitCommand}" CommandParameter="5" ToolTip.Tip="5">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_5_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_5_btn.png" />
                </Grid>
              </Button>
              <Button Grid.Row="4" Grid.Column="3" Classes="key" AutomationProperties.Name="6"
                      Command="{Binding InputDigitCommand}" CommandParameter="6" ToolTip.Tip="6">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_6_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_6_btn.png" />
                </Grid>
              </Button>
              <Button Grid.Row="4" Grid.Column="4" Classes="key" AutomationProperties.Name="menos"
                      Command="{Binding InputOperatorCommand}" CommandParameter="-" ToolTip.Tip="Restar">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_-_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_-_btn.png" />
                </Grid>
              </Button>

              <!-- Fila 6 -->
              <Button Grid.Row="5" Grid.Column="0" Classes="pixel" Content="{Binding LogLabel}"
                      Command="{Binding ScienceCommand}" CommandParameter="log" AutomationProperties.Name="log"
                      ToolTip.Tip="log: base 10 · 10ˣ con 2nd" />
              <Button Grid.Row="5" Grid.Column="1" Classes="key" AutomationProperties.Name="1"
                      Command="{Binding InputDigitCommand}" CommandParameter="1" ToolTip.Tip="1">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_1_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_1_btn.png" />
                </Grid>
              </Button>
              <Button Grid.Row="5" Grid.Column="2" Classes="key" AutomationProperties.Name="2"
                      Command="{Binding InputDigitCommand}" CommandParameter="2" ToolTip.Tip="2">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_2_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_2_btn.png" />
                </Grid>
              </Button>
              <Button Grid.Row="5" Grid.Column="3" Classes="key" AutomationProperties.Name="3"
                      Command="{Binding InputDigitCommand}" CommandParameter="3" ToolTip.Tip="3">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_3_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_3_btn.png" />
                </Grid>
              </Button>
              <Button Grid.Row="5" Grid.Column="4" Classes="key" AutomationProperties.Name="mas"
                      Command="{Binding InputOperatorCommand}" CommandParameter="+" ToolTip.Tip="Sumar">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_+_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_+_btn.png" />
                </Grid>
              </Button>

              <!-- Fila 7 -->
              <Button Grid.Row="6" Grid.Column="0" Classes="pixel" Content="{Binding LnLabel}"
                      Command="{Binding ScienceCommand}" CommandParameter="ln" AutomationProperties.Name="ln"
                      ToolTip.Tip="ln: logaritmo natural · eˣ con 2nd" />
              <Button Grid.Row="6" Grid.Column="1" Classes="pixel" Content="±"
                      Command="{Binding ToggleSignCommand}" AutomationProperties.Name="cambiar_signo" ToolTip.Tip="Cambiar de signo" />
              <Button Grid.Row="6" Grid.Column="2" Classes="key" AutomationProperties.Name="0"
                      Command="{Binding InputDigitCommand}" CommandParameter="0" ToolTip.Tip="0">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_0_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_0_btn.png" />
                </Grid>
              </Button>
              <Button Grid.Row="6" Grid.Column="3" Classes="key" AutomationProperties.Name="coma"
                      Command="{Binding InputDecimalCommand}" ToolTip.Tip="Coma decimal">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_,_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_,_btn.png" />
                </Grid>
              </Button>
              <Button Grid.Row="6" Grid.Column="4" Classes="key" AutomationProperties.Name="igual"
                      Command="{Binding CalculateEqualsCommand}" ToolTip.Tip="Calcular resultado">
                <Grid>
                  <Image Classes="normal" Source="/Assets/Original/normal_=_btn.png" />
                  <Image Classes="pressed" Source="/Assets/Original/Pressed/pressed_=_btn.png" />
                </Grid>
              </Button>
            </Grid>
          </Viewbox>

          <!-- Historial -->
          <Border Grid.Row="1" Grid.RowSpan="3"
                  Width="320"
                  HorizontalAlignment="Left"
                  Padding="10"
                  Background="#2A1220"
                  BorderBrush="#FFA8D2"
                  BorderThickness="2"
                  CornerRadius="8"
                  BoxShadow="0 8 24 0 #66000000"
                  IsVisible="{Binding IsHistoryOpen}">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="4,2,2,6">
                <TextBlock Text="Historial" FontSize="15" FontWeight="Bold" Foreground="#FFE3F0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="link" Content="Borrar" Command="{Binding ClearHistoryCommand}" />
                <Button Grid.Column="2" Classes="link" Content="✕" Command="{Binding ToggleHistoryCommand}" ToolTip.Tip="Cerrar historial" />
              </Grid>

              <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding History}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryEntry">
                      <Button Classes="history"
                              Tag="{Binding Value}"
                              Click="History_Click"
                              ToolTip.Tip="Usar este resultado">
                        <StackPanel HorizontalAlignment="Right">
                          <TextBlock Text="{Binding Expression}"
                                     FontSize="12"
                                     Foreground="#FFB8DA"
                                     HorizontalAlignment="Right"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Result}"
                                     FontSize="19"
                                     Foreground="#FFF4F8"
                                     HorizontalAlignment="Right" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
